---
import '../styles/global.css';

const { title, description, image, jsonld, type = 'website', date } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const home = import.meta.env.BASE_URL;
const ogImage = new URL(image ?? 'berta.webp', new URL(home, Astro.site)).href;
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="theme-color" content="#F7F3EA" />
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Con B de Biología" />
<meta property="og:locale" content="es_ES" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
{date && <meta property="article:published_time" content={date} />}
<link rel="alternate" type="application/rss+xml" title="Con B de Biología" href={home + 'rss.xml'} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..600&family=IBM+Plex+Mono:wght@400&display=swap" rel="stylesheet" />
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
<script data-goatcounter="https://bertamunoz02-blog.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
</head>
<body>
<div class="page">

<header class="bar">
  <a class="brand" href={home}>Con B de Biología</a>
  <nav>
    <a href={home}>Índice</a>
    <a href="https://www.instagram.com/bertamunoz_02/" target="_blank" rel="noopener">Instagram</a>
    <a href="https://www.tiktok.com/@bertamunoz_02" target="_blank" rel="noopener">TikTok</a>
  </nav>
</header>

<main>
  <slot />
</main>

<footer class="footer">
  <div>Con B de Biología · Berta Muñoz</div>
  <div><a href={home + 'rss.xml'}>RSS</a> · <a href="mailto:bertamunoz.bio@gmail.com">Contacto</a></div>
</footer>

</div>
</body>
</html>
