---
import '../styles/global.css';

const { title, description, image, jsonld, type = 'website', date } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const home = import.meta.env.BASE_URL;
const root = new URL(home, Astro.site);
const ogImage = new URL(image ?? 'berta.webp', root).href;
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content="Con B de Biología" />
<meta property="og:locale" content="es_ES" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
{date && <meta property="article:published_time" content={date} />}

<link rel="alternate" type="application/rss+xml" title="Con B de Biología" href={home + 'rss.xml'} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..900&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />

{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body>
<div class="page">

<header class="bar">
  <a href={home}><strong>Con B de Biología</strong></a>
  <nav>
    <a href={home}>Posts</a>
    <a href="https://bertamunoz02.github.io/">Sobre mí</a>
    <a href={home + 'rss.xml'}>RSS</a>
  </nav>
</header>

<main><slot /></main>

<footer class="mono">
  © {new Date().getFullYear()} Berta Muñoz Aranguren ·
  <a href="mailto:bertamunoz02@gmail.com">bertamunoz02@gmail.com</a>
</footer>

</div>
</body>
</html>
